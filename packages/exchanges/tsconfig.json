{
  "extends": "@agentrader/tsconfig/esm.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "../../dts/packages/exchanges",
    "paths": {
      "@agentrader/db": ["../db/src/index.ts"],
      "@agentrader/db/*": ["../db/src/*"],
      "@agentrader/tools": ["../tools/src/index.ts"],
      "@agentrader/tools/*": ["../tools/src/*"],
      "@agentrader/tsconfig/*": ["../tsconfig/*"],
      "@agentrader/types": ["../types/src/index.ts"],
      "@agentrader/types/*": ["../types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../db"
    },
    {
      "path": "../tools"
    },
    {
      "path": "../tsconfig"
    },
    {
      "path": "../types"
    }
  ]
}
